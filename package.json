{
  "name": "kitchenflow-commerce",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": "20.x"
  },
  "scripts": {
    "dev": "pnpm --filter @kitchenflow/web dev",
    "dev:api": "pnpm --filter @kitchenflow/api start:dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@kitchenflow/config": "workspace:*",
    "@nestjs/cli": "^10.4.5",
    "prettier": "^3.3.3",
    "prisma": "^5.22.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3"
  }
}
