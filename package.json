{
  "name": "kitchenflow-commerce",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20 <21"
  },
  "scripts": {
    "dev": "npm run dev --workspace=@kitchenflow/web",
    "dev:api": "npm run start:dev --workspace=@kitchenflow/api",
    "build": "npm run build --workspace=@kitchenflow/web",
    "build:api": "npm run build --workspace=@kitchenflow/api",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@kitchenflow/config": "*",
    "@nestjs/cli": "^10.4.5",
    "prettier": "^3.3.3",
    "prisma": "^5.22.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3"
  }
}
