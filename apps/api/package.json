{
  "name": "@kitchenflow/api",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "prestart:dev": "pnpm --filter @kitchenflow/types build",
    "build": "nest build --type-check false",
    "prebuild": "pnpm --filter @kitchenflow/types build",
    "lint": "eslint src --ext .ts",
    "test:phase5": "node --test test/*.test.js",
    "typecheck": "tsc --noEmit",
    "pretypecheck": "pnpm --filter @kitchenflow/types build",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "prisma db seed"
  },
  "prisma": {
    "schema": "prisma/schema.prisma",
    "seed": "node prisma/seed.js"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.7",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.7",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.4.7",
    "@nestjs/platform-socket.io": "^10.4.7",
    "@nestjs/throttler": "^6.2.1",
    "@nestjs/websockets": "^10.4.7",
    "@kitchenflow/types": "workspace:*",
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.29.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.5",
    "@nestjs/schematics": "^10.2.3",
    "@nestjs/testing": "^10.4.7",
    "@types/node": "^22.9.0",
    "@types/passport-jwt": "^4.0.1",
    "eslint": "^9.14.0",
    "prisma": "^5.22.0",
    "typescript": "^5.6.3"
  }
}
