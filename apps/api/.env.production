# Production values should be injected by Docker, CI, or a secret manager.
NODE_ENV=production
PORT=4000
DATABASE_URL=postgresql://kitchenflow:${POSTGRES_PASSWORD}@postgres:5432/kitchenflow
REDIS_URL=redis://redis:6379
JWT_ACCESS_SECRET=replace-with-secret-manager-value
JWT_REFRESH_SECRET=replace-with-secret-manager-value
CORS_ORIGIN=https://app.example.com
REQUEST_BODY_LIMIT=1mb
